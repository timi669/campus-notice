# ============================================
# 简易校园公告资讯小程序 - 环境变量配置
# 复制此文件为 .env 并修改对应值
# ============================================

# 应用配置
DEBUG=True
SECRET_KEY=please-change-this-to-a-very-long-random-secret-string-for-production

# 数据库配置（MySQL）
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=123456
DATABASE_NAME=campus_notice

# Redis 缓存配置
# 开发环境如未安装 Redis，可保持默认，系统会自动降级为内存缓存
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=True

# CORS 跨域配置（生产环境建议指定具体域名，逗号分隔）
# 示例：CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ORIGINS=*

# 分页配置
PAGE_SIZE_DEFAULT=10
PAGE_SIZE_MAX=100
