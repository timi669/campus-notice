.page { padding: 24rpx; min-height: 100vh; padding-bottom: 40rpx; }
.ml-16 { margin-left: 16rpx; }

.notice-item { margin-bottom: 20rpx; padding: 24rpx; }
.notice-head { display: flex; align-items: center; }
