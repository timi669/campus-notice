<view class="page">
  <view class="search-header">
    <view class="search-input-box">
      <text class="icon">🔍</text>
      <input
        class="search-input"
        type="text"
        placeholder="搜索公告标题、内容..."
        model:value="{{keyword}}"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="onSearchConfirm"
        focus
        adjust-position="{{true}}"
        cursor-spacing="30"
      />
      <text class="clear" hidden="{{!keyword}}" bindtap="clearKeyword">✕</text>
    </view>
    <view class="search-btn" bindtap="onSearchConfirm">搜索</view>
  </view>

  <!-- 搜索前：历史+热门 -->
  <view class="suggestions" wx:if="{{!searched}}">
    <view class="sug-block" wx:if="{{history.length > 0}}">
      <view class="sug-header flex-between">
        <text class="sug-title">🕐 历史搜索</text>
        <text class="clear-history text-sm text-muted" bindtap="clearHistory">清空</text>
      </view>
      <view class="sug-tags">
        <view class="sug-tag" wx:for="{{history}}" wx:key="*this" data-kw="{{item}}" bindtap="tapKeyword">{{item}}</view>
      </view>
    </view>
    <view class="sug-block">
      <view class="sug-header">
        <text class="sug-title">🔥 热门搜索</text>
      </view>
      <view class="sug-tags">
        <view class="sug-tag hot" wx:for="{{hotKeywords}}" wx:key="*this" data-kw="{{item}}" bindtap="tapKeyword">{{item}}</view>
      </view>
    </view>
  </view>

  <!-- 搜索后：结果 -->
  <block wx:else>
    <scroll-view class="filters" scroll-x>
      <view class="filter-tags">
        <view
          class="ftag {{(item.id === categoryId || (!item.id && !categoryId)) ? 'active' : ''}}"
          wx:for="{{categories}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="selectCategory"
        >{{item.name}}</view>
      </view>
    </scroll-view>
    <view class="sort-bar">
      <view class="sort-item {{sort === 'latest' ? 'active' : ''}}" data-sort="latest" bindtap="switchSort">🕐 最新</view>
      <view class="sort-item {{sort === 'hottest' ? 'active' : ''}}" data-sort="hottest" bindtap="switchSort">🔥 最多浏览</view>
      <view class="sort-count text-sm text-muted">共 {{total}} 条结果</view>
    </view>

    <view class="notice-list">
      <view class="notice-item card" wx:for="{{noticeList}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <view class="notice-head flex-between">
          <view class="tag tag-primary" wx:if="{{item.category}}">{{item.category.name}}</view>
          <view class="tag tag-danger" wx:if="{{item.is_top}}">置顶</view>
          <view class="text-sm text-muted flex-1 text-right">{{item.timeText}}</view>
        </view>
        <view class="notice-title text-lg font-bold mt-16 text-ellipsis-2">{{item.title}}</view>
        <view class="notice-summary text-sm text-muted mt-8 text-ellipsis-2" wx:if="{{item.summary}}">{{item.summary}}</view>
        <view class="notice-foot mt-16 text-sm text-muted">👁 {{item.views_count}}</view>
      </view>
    </view>

    <view class="empty" wx:if="{{!loading && noticeList.length === 0}}">
      <text>没有找到"{{keyword}}"相关的公告 😥</text>
      <view class="text-sm text-muted mt-16">换个关键词试试吧</view>
    </view>
    <view class="loading-more text-sm text-muted mt-24 mb-32 text-center" wx:if="{{loading || noMore}}">
      <text wx:if="{{loading}}">加载中...</text>
      <text wx:elif="{{noMore && noticeList.length > 0}}">—— 没有更多了 ——</text>
    </view>
  </block>
</view>
