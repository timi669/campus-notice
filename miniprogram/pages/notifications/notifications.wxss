.page { padding: 0 0 40rpx; min-height: 100vh; background: #F5F7FA; }

.filter-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}
.filter-item {
  padding: 12rpx 32rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 32rpx;
  margin-right: 20rpx;
}
.filter-item.active {
  background: #4F7DFB;
  color: #fff;
}
.read-all {
  margin-left: auto;
  font-size: 26rpx;
  color: #4F7DFB;
  padding: 12rpx 20rpx;
}

.list { padding: 16rpx 24rpx; }

.notif-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  position: relative;
}
.notif-item.read {
  background: #f9f9f9;
}
.notif-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #F56C6C;
  margin-top: 14rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.notif-content {
  flex: 1;
  min-width: 0;
}
.notif-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
}
.notif-item.read .notif-title { color: #999; font-weight: 400; }
.notif-desc {
  font-size: 26rpx;
  color: #888;
  margin-top: 10rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.notif-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 12rpx;
}
.notif-arrow {
  color: #ccc;
  font-size: 40rpx;
  margin-left: 12rpx;
  align-self: center;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}
.empty-icon { font-size: 100rpx; }
.empty-text { font-size: 28rpx; color: #999; margin-top: 24rpx; }

.load-more {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 30rpx 0;
}
