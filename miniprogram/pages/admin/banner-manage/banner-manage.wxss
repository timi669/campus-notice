.page { padding: 24rpx; min-height: 100vh; }
.mt-8 { margin-top: 16rpx; }
.mt-16 { margin-top: 32rpx; }
.mt-24 { margin-top: 48rpx; }
.mt-32 { margin-top: 64rpx; }
.mb-16 { margin-bottom: 32rpx; }
.mb-24 { margin-bottom: 48rpx; }
.ml-8 { margin-left: 16rpx; }
.ml-16 { margin-left: 32rpx; }

.banner-item { display: flex; align-items: flex-start; padding: 24rpx; }
.banner-thumb { width: 200rpx; height: 120rpx; border-radius: 12rpx; background: #f2f3f5; flex: none; }

.mini-btn { flex: 1; }

.field .label { font-size: 26rpx; color: #666; margin-bottom: 12rpx; display: block; }
.form-img { width: 200rpx; height: 120rpx; border-radius: 12rpx; background: #f2f3f5; }
.form-img-empty { font-size: 24rpx; color: #999; }

.ltab {
  padding: 10rpx 28rpx;
  border-radius: 12rpx;
  background: #F2F3F5;
  color: #666;
  font-size: 26rpx;
  margin-right: 16rpx;
}
.ltab.active { background: #4F7DFB; color: #fff; }

.modal-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  display: flex; align-items: center; justify-content: center;
}
.modal {
  width: 86%;
  max-height: 82vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
}
.modal-title { text-align: center; }