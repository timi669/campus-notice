.page { padding: 24rpx 24rpx 40rpx; min-height: 100vh; }
.ml-8 { margin-left: 16rpx; }
.mr-16 { margin-right: 16rpx; }
.ml-8 { margin-left: 16rpx; }
.align-items-center { align-items: center; }

.search-bar { padding: 20rpx 24rpx; }
.search-input { padding: 0 20rpx; height: 64rpx; line-height: 64rpx; font-size: 26rpx; }

.role-tabs { gap: 16rpx; align-items: center; }
.rtab {
  padding: 10rpx 24rpx;
  background: #f2f3f5;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #555;
  margin-right: 16rpx;
}
.rtab.active { background: #4F7DFB; color: #fff; }

.user-item { padding: 24rpx; }
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6A8CFB, #9DB8FF);
  color: #fff;
  font-size: 32rpx;
  text-align: center;
  line-height: 80rpx;
  font-weight: bold;
}
.mini-btn { padding: 0 20rpx; font-size: 24rpx; height: 56rpx; line-height: 56rpx; border-radius: 8rpx; display: inline-flex; align-items: center; justify-content: center; }
