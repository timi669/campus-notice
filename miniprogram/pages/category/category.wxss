.page { display: flex; flex-direction: row; height: 100vh; }

.sidebar {
  width: 200rpx;
  background: #F0F2F5;
  height: 100vh;
}
.side-item {
  padding: 24rpx 16rpx;
  font-size: 26rpx;
  color: #555;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-left: 6rpx solid transparent;
}
.side-item .icon { font-size: 36rpx; margin-bottom: 8rpx; }
.side-item .name { margin-bottom: 4rpx; text-align: center; }
.side-item .count { color: #999; }
.side-item.active {
  background: #fff;
  color: #4F7DFB;
  border-left-color: #4F7DFB;
  font-weight: bold;
}
.side-item.active .count { color: #4F7DFB; }

.content {
  flex: 1;
  height: 100vh;
  padding: 24rpx;
  background: #F5F7FA;
}
.content-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.content-header .title { font-size: 34rpx; }

.notice-item { margin-bottom: 20rpx; }
.notice-head { display: flex; align-items: center; }
.notice-title { line-height: 1.4; }
.notice-summary { line-height: 1.5; }
