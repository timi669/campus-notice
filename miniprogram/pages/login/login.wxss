.page { min-height: 100vh; padding: 40rpx 48rpx; background: linear-gradient(180deg, #EFF4FF 0%, #F5F7FA 40%); }

.logo-wrap { text-align: center; padding: 60rpx 0 40rpx; }
.logo {
  width: 140rpx;
  height: 140rpx;
  line-height: 140rpx;
  margin: 0 auto;
  background: linear-gradient(135deg, #4F7DFB, #8FA8FF);
  border-radius: 40rpx;
  font-size: 72rpx;
  box-shadow: 0 10rpx 30rpx rgba(79,125,251,0.35);
}
.brand { color: #333; }
.slogan { }

.mode-switch {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}
.mode-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
}
.mode-item.active {
  background: linear-gradient(135deg, #4F7DFB, #8FA8FF);
  color: #fff;
  font-weight: bold;
}

.form { padding: 32rpx; }
.form-item .label { font-size: 26rpx; color: #666; margin-bottom: 12rpx; display: block; }

.agree { display: flex; align-items: center; }
.checkbox {
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  margin-right: 12rpx;
  border: 1rpx solid #ccc;
  border-radius: 6rpx;
  color: #fff;
  font-size: 22rpx;
}
.checkbox.checked { background: #4F7DFB; border-color: #4F7DFB; }

.quick { padding: 0 12rpx; }
.mr-16 { margin-right: 16rpx; }
.ml-16 { margin-left: 16rpx; }
