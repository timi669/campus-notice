/* app.wxss 全局样式 */
page {
  background-color: #F5F7FA;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", Arial, sans-serif;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

view, text, input, textarea, button { box-sizing: border-box; }

.container { padding: 24rpx; }

.flex { display: flex; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; }

.mt-8 { margin-top: 8rpx; } .mt-16 { margin-top: 16rpx; } .mt-24 { margin-top: 24rpx; } .mt-32 { margin-top: 32rpx; }
.mb-8 { margin-bottom: 8rpx; } .mb-16 { margin-bottom: 16rpx; } .mb-24 { margin-bottom: 24rpx; } .mb-32 { margin-bottom: 32rpx; }
.p-16 { padding: 16rpx; } .p-24 { padding: 24rpx; }

.text-primary { color: #4F7DFB; }
.text-success { color: #09BB07; }
.text-warning { color: #FF976A; }
.text-danger { color: #F56C6C; }
.text-muted { color: #999; }
.text-sm { font-size: 24rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.font-bold { font-weight: bold; }
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.divider { height: 1rpx; background: #eee; margin: 16rpx 0; }

.btn {
  border-radius: 12rpx;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 32rpx;
}
.btn-primary { background: #4F7DFB; color: #fff; }
.btn-outline { border: 1rpx solid #4F7DFB; color: #4F7DFB; background: #fff; }
.btn-danger { background: #F56C6C; color: #fff; }
.btn-block { width: 100%; }

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
}
.tag-primary { background: #E8F0FF; color: #4F7DFB; }
.tag-warning { background: #FFF2E8; color: #FF976A; }
.tag-danger { background: #FFEBEB; color: #F56C6C; }
.tag-success { background: #E7F9EF; color: #09BB07; }

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.input-box {
  background: #fff;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 80rpx;
  line-height: 80rpx;
}
.textarea-box {
  background: #fff;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  width: 100%;
  min-height: 280rpx;
}

.badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  background: #F56C6C;
  color: #fff;
  margin-left: 8rpx;
}

.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
  border-radius: 8rpx;
}
@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
