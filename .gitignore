# ============ Python 后端 ============
# 虚拟环境
backend/venv/
venv/

# Python 编译缓存
__pycache__/
*.py[cod]
*$py.class

# 测试缓存
.pytest_cache/
.coverage
htmlcov/

# 环境变量（含数据库密码，切勿提交），但保留 .env.example 模板
.env
.env.local
.env.production
!**/.env.example

# 上传文件（用户数据，不属于代码）
backend/uploads/
uploads/

# 日志
*.log

# ============ 微信小程序 ============
# 开发者工具本地缓存
miniprogram/project.private.config.json
miniprogram/.eslintrc.js

# ============ IDE / 系统 ============
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ============ 其它 ============
*.pyc
*.db
*.sqlite3